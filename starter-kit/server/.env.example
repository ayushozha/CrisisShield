# Gradium (TTS)
GRADIUM_API_KEY=
GRADIUM_VOICE_ID=Eu9iL_CYe8N-Gkx_

# ElevenLabs (demo TTS fallback / preferred voice)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=Tu2hPdmCr8ZkKfSFXWyj
ELEVENLABS_MODEL=eleven_turbo_v2_5
TTS_PROVIDER=auto

# OpenAI (LLM)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_DOCS_URL=https://developers.openai.com/api/docs/guides/realtime

# NVIDIA Nemotron ASR (STT)
NVIDIA_ASR_URL=ws://44.241.251.184:8080

# NVIDIA Nemotron LLM
