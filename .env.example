# ─────────────────────────────────────────────────────────────
# VoiceShield Forge — env template (CHECKED IN, no secrets).
# Copy to .env (backend) and fill real keys. Leave a value as a
# placeholder_* string to keep that sponsor adapter in fixture mode.
# Web config lives in apps/web/.env.local (NEXT_PUBLIC_* only).
# ─────────────────────────────────────────────────────────────

PYTHON_VERSION=3.11
APP_ENV=local
PUBLIC_BASE_URL=
HARNESS_MODE=fixture

CEKURA_API_KEY=placeholder_cekura_key
CEKURA_PROJECT_ID=placeholder_cekura_project
CEKURA_BASE_URL=https://api.cekura.ai
CEKURA_MODE=fixture

DAILY_API_KEY=placeholder_daily_key
DAILY_DOMAIN=placeholder.daily.co
DAILY_API_URL=https://api.daily.co/v1
DAILY_MODE=fixture

TWILIO_ACCOUNT_SID=placeholder_twilio_sid
TWILIO_AUTH_TOKEN=placeholder_twilio_token
TWILIO_PHONE_NUMBER=+15555550100
TWILIO_WEBHOOK_SECRET=placeholder_twilio_secret
TWILIO_MODE=fixture

NVIDIA_API_KEY=placeholder_nvidia_key
NVIDIA_NIM_BASE_URL=http://nemotron-fleet-alb-1322439314.us-west-2.elb.amazonaws.com/v1
NVIDIA_RIVA_ENDPOINT=https://placeholder.riva.example
NVIDIA_MODE=live

AWS_REGION=us-west-2
AWS_ACCESS_KEY_ID=placeholder_aws_key
AWS_SECRET_ACCESS_KEY=placeholder_aws_secret
VOICEFORGE_S3_BUCKET=voiceforge-fixture
VOICEFORGE_DDB_TABLE=voiceforge-fixture-runs
AWS_MODE=fixture

OPENAI_API_KEY=placeholder_openai_key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_DOCS_URL=https://developers.openai.com/api/docs/guides/realtime
ANTHROPIC_API_KEY=placeholder_anthropic_key

# NVIDIA public model references
NVIDIA_NEMOTRON_STREAMING_ASR_MODEL=nvidia/nemotron-speech-streaming-en-0.6b
NVIDIA_NEMOTRON_STREAMING_ASR_HF_URL=https://huggingface.co/nvidia/nemotron-speech-streaming-en-0.6b
NVIDIA_PARAKEET_MULTILINGUAL_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3
NVIDIA_PARAKEET_MULTILINGUAL_ASR_HF_URL=https://huggingface.co/nvidia/parakeet-tdt-0.6b-v3
NVIDIA_MAGPIE_TTS_MODEL=nvidia/magpie_tts_multilingual_357m
NVIDIA_MAGPIE_TTS_HF_URL=https://huggingface.co/nvidia/magpie_tts_multilingual_357m
NVIDIA_SORTFORMER_DIARIZATION_MODEL=nvidia/diar_streaming_sortformer_4spk-v2.1
NVIDIA_SORTFORMER_DIARIZATION_HF_URL=https://huggingface.co/nvidia/diar_streaming_sortformer_4spk-v2.1
NVIDIA_NEMO_REPO_URL=https://github.com/NVIDIA-NeMo/NeMo
NVIDIA_NEMO_ASR_FINETUNE_SKILL_URL=https://github.com/NVIDIA-NeMo/NeMo/blob/main/.claude/skills/nemo-speech-asr-finetune/SKILL.md
NEMOTRON_LLM_API_KEY=placeholder_nemotron_key
NEMOTRON_LLM_URL=http://nemotron-fleet-alb-1322439314.us-west-2.elb.amazonaws.com/v1
NEMOTRON_LLM_MODEL=nvidia/nemotron-3-super
NEMOTRON_ENABLE_THINKING=false
